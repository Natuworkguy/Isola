<?xml version="1.0" encoding="utf-8"?>
<!-- Where the build finds its packages. A freshly installed .NET SDK may have no package source set up on a PC,
     and then every package fails to resolve (NU1100), so nuget.org is named here. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
